# --- Obligatorias en producción ---
NODE_ENV=production
DATABASE_URL=postgres://nova:CAMBIAME@localhost:5432/nova
PUBLIC_URL=https://finanzas.tudominio.com      # URL pública con HTTPS (se usa para el callback de Google)
PORT=3000

# Registro: por defecto solo se puede crear el PRIMER usuario. Pon true solo si quieres permitir más.
ALLOW_REGISTRATION=false
SESSION_DAYS=14

# --- Cifrado de tokens OAuth (Gmail). Cadena larga y aleatoria: openssl rand -base64 48 ---
APP_ENCRYPTION_KEY=

# --- Gmail (opcional; sin esto la integración aparece como "No configurada") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NOVA AI con modelo de lenguaje (opcional; sin esto funciona en modo local determinista) ---
ANTHROPIC_API_KEY=
NOVA_AI_MODEL=claude-sonnet-5-5

# --- Notificaciones push (opcional). Genera las claves con: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Programador de alertas y resúmenes (cada 10 min). Pon "off" para desactivarlo.
SCHEDULER=on
